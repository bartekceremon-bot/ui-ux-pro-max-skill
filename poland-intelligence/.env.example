# --- Baza danych (opcjonalna: aplikacja działa bez niej) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/poland_intelligence
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/poland_intelligence

# --- Cache (opcjonalny; domyślnie cache in-process) ---
REDIS_URL=

# --- GUS ---
# BDL działa bez klucza; X-ClientId podnosi limity
GUS_CLIENT_ID=
BDL_API_URL=https://bdl.stat.gov.pl/api/v1
# REGON/BIR1 wymaga klucza użytkownika (SOAP)
GUS_REGON_KEY=
REGON_API_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
TERYT_API_URL=https://api.stat.gov.pl/Home/TerytApi
TERYT_USER=

# --- CEIDG (wymaga tokenu JWT z dane.biznes.gov.pl) ---
CEIDG_API_URL=https://dane.biznes.gov.pl/api/ceidg/v3
CEIDG_JWT=

# --- KRS (bez klucza) ---
KRS_API_URL=https://api-krs.ms.gov.pl/api/krs

# --- Pozostałe źródła publiczne (bez kluczy) ---
DANEGOV_API_URL=https://api.dane.gov.pl/1.4
NBP_API_URL=https://api.nbp.pl/api
GIOS_API_URL=https://api.gios.gov.pl/pjp-api/v1/rest
NFZ_API_URL=https://api.nfz.gov.pl
GEOPORTAL_WMS_URL=https://mapy.geoportal.gov.pl/wss/service/PZGIK/ORTO/WMS/StandardResolution
GEOPORTAL_WFS_URL=
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OPENMETEO_URL=https://api.open-meteo.com/v1
GTFS_CONFIG_URL=

# --- Aplikacja ---
RATE_LIMIT_PER_MIN=60
